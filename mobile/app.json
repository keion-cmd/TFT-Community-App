{
  "expo": {
    "name": "TFT Community App",
    "slug": "tft-community-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "tftcommunity",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "TFT Community App uses the camera to capture your check-in photo."
      }
    },
    "android": {
      "permissions": ["CAMERA"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "TFT Community App uses the camera to capture your check-in photo."
        }
      ]
    ]
  }
}
